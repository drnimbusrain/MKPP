{#
  Kernel function template: compute_adjoint (Adjoint Jacobian J^T evaluation).

  Renders the `compute_adjoint()` function which evaluates the transpose
  Jacobian (adjoint) matrix J^T[i,j] at the given state.

  Only non-zero entries are emitted (sparse adjoint Jacobian).

  Context variables required:
    - num_species: int
    - adjoint_entries_state: list of (i, j, expr) tuples using state(i) format
      These are the entries of J^T (the transposed Jacobian).
    - has_equilibrium: bool (if true, signature includes temp, rh params)

  Requirements: 4.6
#}
#ifdef MKPP_ENABLE_ADJOINT
      template <class StateView, class JacView>
{% if has_runtime_environment %}
      KOKKOS_INLINE_FUNCTION void compute_adjoint(const StateView& state, JacView& J_adj_block, Kokkos::View<const double*, memory_space> jvals_view, const double temp = {{ environment_temperature | default(300.0) }}, const double rh = 0.5{% if has_cloud_gated %}, const double clw = 0.0{% endif %}, const double air_density = {{ environment_air_density | default(2.4476e19) }}) const {
          const double* jvals = jvals_view.data();
          const double Temp = temp;
          const double RH = rh;
          const double AirDensity = air_density;
          (void)RH;  // Reserved for future deliquescence modeling
{% if has_cloud_gated %}
          const double CLW = clw;
{% endif %}
{% else %}
      KOKKOS_INLINE_FUNCTION void compute_adjoint(const StateView& state, JacView& J_adj_block, Kokkos::View<const double*, memory_space> jvals_view) const {
          const double* jvals = jvals_view.data();
{% endif %}
          // --- Sparse Analytical Adjoint Jacobian Entries J_adj_block(i, j) = J^T(i, j) ---
{% for entry in adjoint_entries_state %}
          // J^T({{ species[entry[0]].name }}, {{ species[entry[1]].name }}): d(d[{{ species[entry[1]].name }}]/dt) / d[{{ species[entry[0]].name }}]
          J_adj_block({{ entry[0] }}, {{ entry[1] }}) = {{ entry[2] }};
{% endfor %}
      }
#endif
