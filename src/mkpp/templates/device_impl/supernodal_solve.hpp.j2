{# Compact sparse forward/back substitution with implicit unit L diagonal. #}
#pragma once
#include <Kokkos_Core.hpp>
namespace mkpp::generated::{{ mechanism_name }}::detail {
#if defined(MKPP_DEFINE_HOST_KERNELS)
void
#else
KOKKOS_INLINE_FUNCTION void
#endif
solve_plan(const double* lu, const double* rhs, double* solution) {
  constexpr int N = {{ num_species }};
  struct Entry { int column, slot; };
  static constexpr int lower_offsets[] = { {{ compact.lower_offsets | join(', ') }} };
  static constexpr int upper_offsets[] = { {{ compact.upper_offsets | join(', ') }} };
  static constexpr int diagonal[] = { {{ compact.diagonals | join(', ') }} };
  static constexpr Entry lower[] = {
{% for entry in compact.lower %}
    { {{ entry[0] }}, {{ entry[1] }} },
{% else %}
    { 0, 0 },
{% endfor %}
  };
  static constexpr Entry upper[] = {
{% for entry in compact.upper %}
    { {{ entry[0] }}, {{ entry[1] }} },
{% else %}
    { 0, 0 },
{% endfor %}
  };
  double work[N];
  for (int row = 0; row < N; ++row) {
    work[row] = rhs[row];
    for (int entry = lower_offsets[row]; entry < lower_offsets[row + 1]; ++entry)
      work[row] -= lu[lower[entry].slot] * work[lower[entry].column];
  }
  for (int row = N - 1; row >= 0; --row) {
    solution[row] = work[row];
    for (int entry = upper_offsets[row]; entry < upper_offsets[row + 1]; ++entry)
      solution[row] -= lu[upper[entry].slot] * solution[upper[entry].column];
    solution[row] /= lu[diagonal[row]];
  }
}
}  // namespace mkpp::generated::{{ mechanism_name }}::detail
