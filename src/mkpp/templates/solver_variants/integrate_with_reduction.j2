{#
  Solver variant template: integrate_with_reduction()

  Renders the auto-reduction Rosenbrock integration function.
  Differences from standard integrate:
    1. Accepts importance_threshold parameter
    2. Maintains bool active[NUM_SPECIES] array
    3. Computes F1 rates first for importance evaluation
    4. Classifies species as active/frozen based on importance
    5. Conditional W-matrix entries (identity for frozen species)
    6. Annotated LU expressions with conditional skip for frozen species
    7. Forward/backward subs with is_reduction=true (active guards)
    8. Skips first F evaluation in stage loop (F1 already computed)

  Context keys used:
    - num_species, species, permutation, has_equilibrium
    - tableau (name, stages, ELO, Gamma, M, E, NewF, A_matrix, C_matrix)
    - jacobian_entries, f_exprs
    - needed_w, non_zero_jac_set, blocks
    - lu_expressions, forward_sub_steps, backward_sub_steps
    - annotated_expressions (optional, for conditional LU skipping)
    - tolerance_arrays (atol, rtol)

  Requirements: 4.2
#}
{% import "macros/lu_solve_forward.j2" as fwd %}
{% import "macros/lu_solve_backward.j2" as bwd %}
      template <class StateView>
      KOKKOS_INLINE_FUNCTION void integrate_with_reduction(
{% if has_runtime_environment %}
          double dt_total, StateView& state, Kokkos::View<const double*, memory_space> jvals_view, double importance_threshold, const double temp = {{ environment_temperature | default(300.0) }}, const double rh = 0.5{% if has_cloud_gated %}, const double clw = 0.0{% endif %}, const double air_density = {{ environment_air_density | default(2.4476e19) }}) const
{% else %}
          double dt_total, StateView& state, Kokkos::View<const double*, memory_space> jvals_view, double importance_threshold) const
{% endif %}
      {
          const double* jvals = jvals_view.data();
{% if has_runtime_environment %}
          const double Temp = temp;
          const double RH = rh;
          const double AirDensity = air_density;
          (void)RH;  // Reserved for future deliquescence modeling
{% if has_cloud_gated %}
          const double CLW = clw;
{% endif %}
{% endif %}
          const int NUM_SPECIES = {{ num_species }};
          // {{ tableau.name }} coefficients ({{ tableau.stages }}-stage, order {{ tableau.ELO | int }})
          const double g = {{ "%.17g" | format(tableau.Gamma[0]) }};
          const double safety = 0.9;
          const double max_growth = 6.0;
          const double min_shrink = 0.2;

          bool active[NUM_SPECIES];
          double t = 0.0;
          double dt = Kokkos::fmin(dt_total, 1.0);  // conservative initial step

          // Initialize all species as active
{% for i in range(num_species) %}
          active[{{ i }}] = true;
{% endfor %}

          while (t < dt_total) {
          dt = Kokkos::min(dt, dt_total - t);
          const double inv_g_dt = 1.0 / (g * dt);

          // 0. Hoist state values into scalar registers
{% if permutation %}
          // NOTE: State access uses permuted species ordering
{% endif %}
{% for i in range(num_species) %}
{% if permutation %}
          const double S_{{ i }} = state({{ permutation[i] }});
{% else %}
          const double S_{{ i }} = state({{ i }});
{% endif %}
{% endfor %}

          // 1. Stage 1 Rates (F1)
{% for i in range(num_species) %}
          double F1_{{ i }} = {{ f_exprs[i] }};
{% endfor %}

          // 2. Evaluate importance and update active set
{% for i in range(num_species) %}
{% if permutation %}
          active[{{ i }}] = (Kokkos::fabs(F1_{{ i }}) / (atol[{{ i }}] + rtol[{{ i }}] * Kokkos::fabs(state({{ permutation[i] }}))) >= importance_threshold);
{% else %}
          active[{{ i }}] = (Kokkos::fabs(F1_{{ i }}) / (atol[{{ i }}] + rtol[{{ i }}] * Kokkos::fabs(state({{ i }}))) >= importance_threshold);
{% endif %}
{% endfor %}

          // 3. Analytical Jacobian & Iteration Matrix W (identity for frozen species)
{% for entry in jacobian_entries %}
          double J_{{ entry[0] }}_{{ entry[1] }} = {{ entry[2] }};
{% endfor %}
{% for entry in needed_w %}
{% set i = entry[0] %}
{% set j = entry[1] %}
{% if i == j %}
{% if (i, j) in non_zero_jac_set %}
          double W_{{ i }}_{{ j }} = active[{{ i }}] ? (inv_g_dt - J_{{ i }}_{{ j }}) : 1.0;
{% else %}
          double W_{{ i }}_{{ j }} = active[{{ i }}] ? inv_g_dt : 1.0;
{% endif %}
{% elif (i, j) in non_zero_jac_set %}
          double W_{{ i }}_{{ j }} = (active[{{ i }}] && active[{{ j }}]) ? (-J_{{ i }}_{{ j }}) : 0.0;
{% else %}
          double W_{{ i }}_{{ j }} = 0.0;
{% endif %}
{% endfor %}

          // 4. Symbolic LU Factorization (conditional skip for frozen species)
{% if annotated_expressions is defined and annotated_expressions %}
{% for ann in annotated_expressions %}
{% if ann.depends_on %}
{% set cond_parts = [] %}
{% for d in ann.depends_on %}
{% if cond_parts.append("active[" ~ d ~ "]") %}{% endif %}
{% endfor %}
{% if ann.row == ann.col %}
          double {{ ann.kind }}_{{ ann.row }}_{{ ann.col }} = ({{ cond_parts | join(" && ") }}) ? ({{ ann.expr }}) : 1.0;
{% else %}
          double {{ ann.kind }}_{{ ann.row }}_{{ ann.col }} = ({{ cond_parts | join(" && ") }}) ? ({{ ann.expr }}) : 0.0;
{% endif %}
{% else %}
          double {{ ann.kind }}_{{ ann.row }}_{{ ann.col }} = {{ ann.expr }};
{% endif %}
{% endfor %}
{% else %}
{% for entry in lu_expressions %}
          double {{ entry.kind }}_{{ entry.i }}_{{ entry.j }} = {{ entry.expr }};
{% endfor %}
{% endif %}
{#- Stage loop: unrolled at template-render time using tableau coefficients -#}
{% set ns = namespace(current_F="F1", rhs_prefix="F1") %}
{% for stage in range(1, tableau.stages + 1) %}

          // --- Stage {{ stage }} ---
{% if stage > 1 %}
          // Intermediate state Y{{ stage }}
{% for i in range(num_species) %}
{% set terms = [] %}
{% for j in range(1, stage) %}
{% set a_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% if tableau.A_matrix[a_idx] != 0.0 %}
{% if terms.append((tableau.A_matrix[a_idx], "K" ~ j ~ "_" ~ i)) %}{% endif %}
{% endif %}
{% endfor %}
{% if not terms %}
          double Y{{ stage }}_{{ i }} = S_{{ i }};
{% elif terms | length == 1 and terms[0][0] == 1.0 %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ terms[0][1] }};
{% else %}
{% set parts = [] %}
{% for t in terms %}
{% if t[0] == 1.0 %}
{% if parts.append(t[1]) %}{% endif %}
{% else %}
{% if parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}{% endif %}
{% endif %}
{% endfor %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ parts | join(" + ") }};
{% endif %}
{% endfor %}
{% endif %}
{% if tableau.NewF[stage - 1] %}
{% if stage == 1 %}
          // F1 already computed above (used for importance evaluation)
{% set ns.current_F = "F1" %}
{% else %}
          // Rate evaluation F{{ stage }} at Y{{ stage }}
{% for i in range(num_species) %}
          double F{{ stage }}_{{ i }} = {{ f_exprs[i] | sub_state_var("Y" ~ stage) }};
{% endfor %}
{% set ns.current_F = "F" ~ stage %}
{% endif %}
{% else %}
          // NewF=false: reuse {{ ns.current_F }} for stage {{ stage }}
{% endif %}
{% if stage == 1 %}
{% set ns.rhs_prefix = "F1" %}
{% else %}
          // RHS for stage {{ stage }}
{% for i in range(num_species) %}
{% set c_terms = [] %}
{% for j in range(1, stage) %}
{% set c_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% if tableau.C_matrix[c_idx] != 0.0 %}
{% if c_terms.append((tableau.C_matrix[c_idx], "K" ~ j ~ "_" ~ i)) %}{% endif %}
{% endif %}
{% endfor %}
{% if not c_terms %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F }}_{{ i }};
{% else %}
{% set sum_parts = [] %}
{% for ct in c_terms %}
{% if sum_parts.append("(" ~ "%.17g" | format(ct[0]) ~ " / dt) * " ~ ct[1]) %}{% endif %}
{% endfor %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F }}_{{ i }} + {{ sum_parts | join(" + ") }};
{% endif %}
{% endfor %}
{% set ns.rhs_prefix = "rhs" ~ stage %}
{% endif %}
{{ fwd.emit_forward_sub(forward_sub_steps, ns.rhs_prefix, "y" ~ stage, blocks=blocks, is_reduction=true, indent="          ", k_prefix="K" ~ stage) }}
{{ bwd.emit_backward_sub(backward_sub_steps, "y" ~ stage, "K" ~ stage, blocks=blocks, is_reduction=true, indent="          ") }}
{% endfor %}

          // --- Solution update and error estimation ---
          double err_norm_sq = 0.0;
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
          {
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% if m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}{% endif %}
{% endif %}
{% endfor %}
{% if m_terms %}
{% set m_parts = [] %}
{% for mt in m_terms %}
{% if mt[0] == 1.0 %}
{% if m_parts.append(mt[1]) %}{% endif %}
{% else %}
{% if m_parts.append("%.17g" | format(mt[0]) ~ " * " ~ mt[1]) %}{% endif %}
{% endif %}
{% endfor %}
              double Ynew_i = S_{{ i }} + {{ m_parts | join(" + ") }};
{% else %}
              double Ynew_i = S_{{ i }} + 0.0;
{% endif %}
              double ymax = Kokkos::fmax(Kokkos::fabs(state({{ state_idx }})), Kokkos::fabs(Ynew_i));
              double sci = atol[{{ i }}] + rtol[{{ i }}] * ymax;
{% set e_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.E[j] != 0.0 %}
{% if e_terms.append((tableau.E[j], "K" ~ (j + 1) ~ "_" ~ i)) %}{% endif %}
{% endif %}
{% endfor %}
{% if e_terms %}
{% set e_parts = [] %}
{% for et in e_terms %}
{% if et[0] == 1.0 %}
{% if e_parts.append(et[1]) %}{% endif %}
{% else %}
{% if e_parts.append("%.17g" | format(et[0]) ~ " * " ~ et[1]) %}{% endif %}
{% endif %}
{% endfor %}
              double yerr_i = {{ e_parts | join(" + ") }};
{% else %}
              double yerr_i = 0.0;
{% endif %}
              err_norm_sq += (yerr_i / sci) * (yerr_i / sci);
          }
{% endfor %}
          double err_norm = Kokkos::sqrt(err_norm_sq / {{ num_species }});
          err_norm = Kokkos::fmax(err_norm, 1.0e-10);

{% set elo_exp = 1.0 / tableau.ELO %}
          // Step Size Control (order {{ tableau.ELO | int }}: exponent = 1/{{ tableau.ELO | int }} = {{ "%.17g" | format(elo_exp) }})
{% if tableau.ELO == 2.0 %}
          double factor = safety / Kokkos::sqrt(err_norm);
{% elif tableau.ELO == 3.0 %}
          double factor = safety / Kokkos::cbrt(err_norm);
{% else %}
          double factor = safety * Kokkos::pow(err_norm, -{{ "%.17g" | format(elo_exp) }});
{% endif %}
          factor = Kokkos::fmax(min_shrink, Kokkos::fmin(factor, max_growth));

          if (err_norm <= 1.0) {
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% if m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}{% endif %}
{% endif %}
{% endfor %}
{% if m_terms %}
{% set m_parts = [] %}
{% for mt in m_terms %}
{% if mt[0] == 1.0 %}
{% if m_parts.append(mt[1]) %}{% endif %}
{% else %}
{% if m_parts.append("%.17g" | format(mt[0]) ~ " * " ~ mt[1]) %}{% endif %}
{% endif %}
{% endfor %}
              if (active[{{ i }}]) state({{ state_idx }}) += {{ m_parts | join(" + ") }};
{% else %}
              if (active[{{ i }}]) state({{ state_idx }}) += 0.0;
{% endif %}
{% endfor %}
              t += dt;
              dt *= factor;
          } else {
              dt *= factor;
          }
          } // end while (t < dt_total)
      }
