{#
  Standard Rosenbrock integrate() function template.

  Renders the complete integrate() function with:
  - Function signature (template parameter, KOKKOS_INLINE_FUNCTION)
  - Solver constants (g, safety, max_growth, min_shrink)
  - Time-stepping while loop
  - State hoisting into scalars (S_i)
  - Jacobian evaluation (J_i_j)
  - W-matrix formation (emit_w_matrix macro)
  - LU factorization (emit_lu_factorize macro)
  - Rosenbrock stage loop (fully unrolled at template-render time)
  - Error estimation and step-size control
  - Accept/reject logic with state update

  Context variables required:
    num_species          - int
    tableau              - dict with name, stages, ELO, Gamma, M, E, NewF, A_matrix, C_matrix
    jacobian_entries     - list of (i, j, expr_str) tuples
    needed_w             - sorted list of (i, j) tuples
    non_zero_jac_set     - set of (i, j) tuples
    lu_expressions       - list of dicts {kind, i, j, expr}
    forward_sub_steps    - list of dicts {i, raw_expr}
    backward_sub_steps   - list of dicts {i, raw_expr}
    f_exprs              - list of C++ rate expressions per species
    permutation          - list of int or None
    blocks               - list of block dicts or None
    has_equilibrium      - bool
    tolerance_arrays     - dict with atol, rtol lists
    initial_step_seed    - C++ literal token for the ramp seed member default

  Requirements: 4.1
#}
      /**
       * @brief Initial-step seed for the adaptive Rosenbrock ramp.
       *
       * The first internal substep of every integrate() call starts at
       * dt_total * initial_step_seed.  The compile-time value is baked as the
       * initializer; a host may override the member before a solve (per
       * SolverKernels instance) without regenerating this header.
       */
      double initial_step_seed = {{ initial_step_seed }};

      /**
       * @brief Performs adaptive time-stepping Rosenbrock integration over dt_total.
       *
       * @tparam StateView Kokkos View type for species concentrations [NUM_SPECIES].
       * @param dt_total Total physical time step duration [s].
       * @param state Input/output species concentration vector [NUM_SPECIES].
       * @param jvals Array of photolysis rate constants [NUM_PHOTOLYSIS].
       */
      template <class StateView>
{% if has_runtime_environment %}
      KOKKOS_INLINE_FUNCTION void integrate(double dt_total, StateView& state, Kokkos::View<const double*, memory_space> jvals_view, const double temp = {{ environment_temperature | default(300.0) }}, const double rh = 0.5{% if has_cloud_gated %}, const double clw = 0.0{% endif %}, const double air_density = {{ environment_air_density | default(2.4476e19) }}) const {
          const double* jvals = jvals_view.data();
          const double Temp = temp;
          const double RH = rh;
          const double AirDensity = air_density;
          (void)RH;  // Reserved for future deliquescence modeling
{% if has_cloud_gated %}
          const double CLW = clw;
          (void)CLW;  // Referenced by the gated reaction's compiled chunks.
{% endif %}
{% else %}
      KOKKOS_INLINE_FUNCTION void integrate(double dt_total, StateView& state, Kokkos::View<const double*, memory_space> jvals_view) const {
          const double* jvals = jvals_view.data();
{% endif %}
          const int NUM_SPECIES = {{ num_species }};
          const auto state_accessor = detail::make_stride_view(state);
          // {{ tableau.name }} coefficients ({{ tableau.stages }}-stage, order {{ tableau.ELO | int }})
          const double g = {{ "%.17g" | format(tableau.Gamma[0]) }};
          const double safety = 0.9;
          const double max_growth = 6.0;
          const double min_shrink = 0.2;
          const double rejection_factor_decrease = 0.1;
          const double h_min = dt_total * 1.0e-15;
          double t = 0.0;
          // First substep of the adaptive ramp; the seed member carries the
          // compile-time default and any host-set runtime override.
          double dt = dt_total * initial_step_seed;
          bool reject_last_dt = false;
          bool reject_more_dt = false;

          while (t < dt_total) {
          dt = Kokkos::min(dt, dt_total - t);
          const double inv_g_dt = 1.0 / (g * dt);

          // --- 0. Hoist State Values into Scalar Registers ---
{% if permutation %}
          // NOTE: State access uses permuted species ordering for RCM bandwidth reduction
{% endif %}
{% for info in state_hoist_info %}
          const double S_{{ info.reg_idx }} = state(Species::{{ info.name }});  // [{{ info.name }}]
{% endfor %}
          // The expression-dense Jacobian is evaluated by bounded compiled
          // units.  The solver still uses the same symbolic sparse LU plan.
#ifndef MKPP_USE_UNROLLED_REFERENCE
          double J_values[{{ [1, compact.j_slots | length] | max }}] = {};
          auto jacobian_accessor = detail::StrideView<double, 2>::compact(J_values);
{% for chunk in compiled_jacobian_chunks %}
          detail::compute_jacobian_chunk_{{ loop.index0 }}(state_accessor, jacobian_accessor, jvals, {% if has_runtime_environment %}temp, rh{% if has_cloud_gated %}, clw{% endif %}{% else %}0.0, 0.0{% endif %}, {% if has_runtime_environment %}air_density{% else %}{{ environment_air_density | default(2.4476e19) }}{% endif %});
{% endfor %}
          double W_values[{{ compact.w_slots | length }}];
{% for location in compact.w_locations %}
{% set i = location[0] %}{% set j = location[1] %}
          W_values[{{ loop.index0 }}] = {% if i == j %}inv_g_dt{% else %}0.0{% endif %}{% if location in compact.j_slots %} - J_values[{{ compact.j_slots[location] }}]{% endif %};
{% endfor %}
          double LU_values[{{ compact.lu_slots | length }}];
          detail::factorize_plan(W_values, LU_values);
#else
          double J_values[NUM_SPECIES * NUM_SPECIES] = {};
          auto jacobian_accessor = detail::make_stride_view<double, 2>(J_values, NUM_SPECIES, 1);
{% for chunk in compiled_jacobian_chunks %}
          detail::compute_jacobian_chunk_{{ loop.index0 }}(state_accessor, jacobian_accessor, jvals, {% if has_runtime_environment %}temp, rh{% if has_cloud_gated %}, clw{% endif %}{% else %}0.0, 0.0{% endif %}, {% if has_runtime_environment %}air_density{% else %}{{ environment_air_density | default(2.4476e19) }}{% endif %});
{% endfor %}
          // Analytical Jacobian & Iteration Matrix W = inv_g_dt*I - J (sparse)
{% for entry in jacobian_entries %}
{% if permutation %}
          double J_{{ entry[0] }}_{{ entry[1] }} = J_values[{{ permutation[entry[0]] }} * NUM_SPECIES + {{ permutation[entry[1]] }}];
{% else %}
          double J_{{ entry[0] }}_{{ entry[1] }} = J_values[{{ entry[0] }} * NUM_SPECIES + {{ entry[1] }}];
{% endif %}
{% endfor %}
          double W_values[NUM_SPECIES * NUM_SPECIES] = {};
{% for entry in needed_w %}
{% set i = entry[0] %}
{% set j = entry[1] %}
{% if i == j %}
{% if (i, j) in non_zero_jac_set %}
          W_values[{{ i }} * NUM_SPECIES + {{ j }}] = inv_g_dt - J_{{ i }}_{{ j }};
{% else %}
          W_values[{{ i }} * NUM_SPECIES + {{ j }}] = inv_g_dt;
{% endif %}
{% elif (i, j) in non_zero_jac_set %}
          W_values[{{ i }} * NUM_SPECIES + {{ j }}] = -J_{{ i }}_{{ j }};
{% endif %}
{% endfor %}
          double LU_values[NUM_SPECIES * NUM_SPECIES] = {};
{% for chunk in compiled_lu_chunks %}
          detail::factorize_lu_chunk_{{ loop.index0 }}(W_values, LU_values);
{% endfor %}
#endif
{% set ns = namespace(current_F_prefix="", rhs_prefix="") %}
{% for stage in range(1, tableau.stages + 1) %}

          // --- Stage {{ stage }} ---
{% if stage > 1 %}
          // Intermediate state Y{{ stage }}
{% for i in range(num_species) %}
{% set terms = [] %}
{% for j in range(1, stage) %}
{% set a_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% set a_val = tableau.A_matrix[a_idx] %}
{% if a_val != 0.0 %}
{% set _ = terms.append((a_val, "K" ~ j ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if terms | length == 0 %}
          double Y{{ stage }}_{{ i }} = S_{{ i }};
{% elif terms | length == 1 and terms[0][0] == 1.0 %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ terms[0][1] }};
{% else %}
{% set sum_parts = [] %}
{% for t in terms %}
{% if t[0] == 1.0 %}
{% set _ = sum_parts.append(t[1]) %}
{% else %}
{% set _ = sum_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
          double Y{{ stage }}_{{ i }} = S_{{ i }} + {{ sum_parts | join(" + ") }};
{% endif %}
{% endfor %}
{% endif %}
{% if tableau.NewF[stage - 1] %}
{% if stage == 1 %}
          // Rate evaluation F{{ stage }} at S
{% for i in range(num_species) %}
{% if loop.first %}
          double F_values_{{ stage }}[NUM_SPECIES];
          auto rate_accessor_{{ stage }} = detail::make_stride_view<double, 1>(F_values_{{ stage }}, 1);
{% for chunk in compiled_rate_chunks %}
          detail::compute_rates_chunk_{{ loop.index0 }}(state_accessor, rate_accessor_{{ stage }}, jvals, {% if has_runtime_environment %}temp, rh{% if has_cloud_gated %}, clw{% endif %}{% else %}0.0, 0.0{% endif %}, {% if has_runtime_environment %}air_density{% else %}{{ environment_air_density | default(2.4476e19) }}{% endif %});
{% endfor %}
{% endif %}
{% if permutation %}
          double F{{ stage }}_{{ i }} = F_values_{{ stage }}[{{ permutation[i] }}];
{% else %}
          double F{{ stage }}_{{ i }} = F_values_{{ stage }}[{{ i }}];
{% endif %}
{% endfor %}
{% set ns.current_F_prefix = "F" ~ stage %}
{% else %}
          // Rate evaluation F{{ stage }} at Y{{ stage }}
{% for i in range(num_species) %}
{% if loop.first %}
          double stage_state_{{ stage }}[NUM_SPECIES];
{% endif %}
{% if permutation %}
          stage_state_{{ stage }}[{{ permutation[i] }}] = Y{{ stage }}_{{ i }};
{% else %}
          stage_state_{{ stage }}[{{ i }}] = Y{{ stage }}_{{ i }};
{% endif %}
{% if loop.last %}
          double F_values_{{ stage }}[NUM_SPECIES];
          auto rate_accessor_{{ stage }} = detail::make_stride_view<double, 1>(F_values_{{ stage }}, 1);
          auto stage_state_accessor_{{ stage }} = detail::make_stride_view<double, 1>(stage_state_{{ stage }}, 1);
{% for chunk in compiled_rate_chunks %}
          detail::compute_rates_chunk_{{ loop.index0 }}(stage_state_accessor_{{ stage }}, rate_accessor_{{ stage }}, jvals, {% if has_runtime_environment %}temp, rh{% if has_cloud_gated %}, clw{% endif %}{% else %}0.0, 0.0{% endif %}, {% if has_runtime_environment %}air_density{% else %}{{ environment_air_density | default(2.4476e19) }}{% endif %});
{% endfor %}
{% endif %}
{% endfor %}
{% for i in range(num_species) %}
{% if permutation %}
          double F{{ stage }}_{{ i }} = F_values_{{ stage }}[{{ permutation[i] }}];
{% else %}
          double F{{ stage }}_{{ i }} = F_values_{{ stage }}[{{ i }}];
{% endif %}
{% endfor %}
{% set ns.current_F_prefix = "F" ~ stage %}
{% endif %}
{% else %}
          // NewF=false: reuse {{ ns.current_F_prefix }} for stage {{ stage }}
{% endif %}
{% if stage == 1 %}
{% set ns.rhs_prefix = ns.current_F_prefix %}
{% else %}
          // RHS for stage {{ stage }}
{% for i in range(num_species) %}
{% set c_terms = [] %}
{% for j in range(1, stage) %}
{% set c_idx = (stage - 1) * (stage - 2) // 2 + j - 1 %}
{% set c_val = tableau.C_matrix[c_idx] %}
{% if c_val != 0.0 %}
{% set _ = c_terms.append((c_val, "K" ~ j ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if c_terms | length == 0 %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F_prefix }}_{{ i }};
{% else %}
{% set sum_parts = [] %}
{% for t in c_terms %}
{% set _ = sum_parts.append("(" ~ ("%.17g" | format(t[0])) ~ " / dt) * " ~ t[1]) %}
{% endfor %}
          double rhs{{ stage }}_{{ i }} = {{ ns.current_F_prefix }}_{{ i }} + {{ sum_parts | join(" + ") }};
{% endif %}
{% endfor %}
{% set ns.rhs_prefix = "rhs" ~ stage %}
{% endif %}
          double rhs_values_{{ stage }}[NUM_SPECIES];
{% for i in range(num_species) %}
          rhs_values_{{ stage }}[{{ i }}] = {{ ns.rhs_prefix }}_{{ i }};
{% endfor %}
          double K_values_{{ stage }}[NUM_SPECIES];
#ifndef MKPP_USE_UNROLLED_REFERENCE
          detail::solve_plan(LU_values, rhs_values_{{ stage }}, K_values_{{ stage }});
#else
          detail::solve_lu(LU_values, rhs_values_{{ stage }}, K_values_{{ stage }});
#endif
{% for i in range(num_species) %}
          double K{{ stage }}_{{ i }} = K_values_{{ stage }}[{{ i }}];
{% endfor %}
{% endfor %}

          // --- Solution update and error estimation ---
          double err_norm_sq = 0.0;
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% set _ = m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if m_terms | length > 0 %}
{% set m_parts = [] %}
{% for t in m_terms %}
{% if t[0] == 1.0 %}
{% set _ = m_parts.append(t[1]) %}
{% else %}
{% set _ = m_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set m_expr = m_parts | join(" + ") %}
{% else %}
{% set m_expr = "0.0" %}
{% endif %}
{% set e_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.E[j] != 0.0 %}
{% set _ = e_terms.append((tableau.E[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if e_terms | length > 0 %}
{% set e_parts = [] %}
{% for t in e_terms %}
{% if t[0] == 1.0 %}
{% set _ = e_parts.append(t[1]) %}
{% else %}
{% set _ = e_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set e_expr = e_parts | join(" + ") %}
{% else %}
{% set e_expr = "0.0" %}
{% endif %}
          {
              double Ynew_i = S_{{ i }} + {{ m_expr }};
              double ymax = Kokkos::fmax(Kokkos::fabs(state({{ state_idx }})), Kokkos::fabs(Ynew_i));
              // Tolerances are stored in physical species order, while the
              // generated scalar registers may use the RCM permutation.
              double sci = atol[{{ state_idx }}] + rtol[{{ state_idx }}] * ymax;
              double yerr_i = {{ e_expr }};
              err_norm_sq += (yerr_i / sci) * (yerr_i / sci);
          }
{% endfor %}
          double err_norm = Kokkos::sqrt(err_norm_sq / {{ num_species }});
          err_norm = Kokkos::fmax(err_norm, 1.0e-10);

{% set elo_exponent = 1.0 / tableau.ELO %}
          // Step Size Control (order {{ tableau.ELO | int }}: exponent = 1/{{ tableau.ELO | int }} = {{ "%.17g" | format(elo_exponent) }})
{% if tableau.ELO == 2.0 %}
          double factor = safety / Kokkos::sqrt(err_norm);
{% elif tableau.ELO == 3.0 %}
          double factor = safety / Kokkos::cbrt(err_norm);
{% else %}
          double factor = safety * Kokkos::pow(err_norm, -{{ "%.17g" | format(elo_exponent) }});
{% endif %}
          factor = Kokkos::fmax(min_shrink, Kokkos::fmin(factor, max_growth));

          if (err_norm <= 1.0) {
{% for i in range(num_species) %}
{% if permutation %}
{% set state_idx = permutation[i] %}
{% else %}
{% set state_idx = i %}
{% endif %}
{% set m_terms = [] %}
{% for j in range(tableau.stages) %}
{% if tableau.M[j] != 0.0 %}
{% set _ = m_terms.append((tableau.M[j], "K" ~ (j + 1) ~ "_" ~ i)) %}
{% endif %}
{% endfor %}
{% if m_terms | length > 0 %}
{% set m_parts = [] %}
{% for t in m_terms %}
{% if t[0] == 1.0 %}
{% set _ = m_parts.append(t[1]) %}
{% else %}
{% set _ = m_parts.append("%.17g" | format(t[0]) ~ " * " ~ t[1]) %}
{% endif %}
{% endfor %}
{% set m_expr = m_parts | join(" + ") %}
{% else %}
{% set m_expr = "0.0" %}
{% endif %}
              state({{ state_idx }}) += {{ m_expr }};
{% endfor %}
              t += dt;
              double next_dt = Kokkos::fmax(h_min, Kokkos::fmin(dt * factor, dt_total));
              // MICM deliberately prevents a step-size increase immediately
              // after a rejected attempt.  This keeps the accepted-step
              // sequence stable for stiff atmospheric mechanisms.
              if (reject_last_dt) next_dt = Kokkos::fmin(next_dt, dt);
              reject_last_dt = false;
              reject_more_dt = false;
              dt = next_dt;
          } else {
              // Match MICM's rejection controller: after two consecutive
              // rejections, force a tenfold reduction instead of accepting
              // the bounded error-controller factor.
              dt *= reject_more_dt ? rejection_factor_decrease : factor;
              reject_more_dt = reject_last_dt;
              reject_last_dt = true;
          }
          } // end while (t < dt_total)
      }
