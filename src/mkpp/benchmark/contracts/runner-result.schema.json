{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MKPP runner-result contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "block": {
      "type": "integer",
      "minimum": 0
    },
    "order_position": {
      "type": "integer",
      "minimum": 0
    },
    "solver": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "micm",
            "kpp",
            "mkpp"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "backend": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "version",
        "revision",
        "backend",
        "method"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "scenario": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozen": {
          "type": "boolean"
        },
        "controls": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "sha256",
        "frozen",
        "controls"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "binary_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "asset_sha256": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "minItems": 0
        },
        "compiler": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "precision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "binary_sha256",
        "asset_sha256",
        "compiler",
        "flags",
        "precision"
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "properties": {
        "hardware_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "physical_cores": {
          "type": "integer",
          "minimum": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1
        },
        "affinity": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "numa_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "hardware_id",
        "physical_cores",
        "threads",
        "affinity",
        "numa_policy"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "properties": {
        "boundary": {
          "enum": [
            "steady_state_solve",
            "lifecycle"
          ]
        },
        "elapsed_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cell_steps": {
          "type": "integer",
          "minimum": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "synchronized": {
          "type": "boolean"
        },
        "synchronization": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "lifecycle_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "minProperties": 0,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "boundary",
        "elapsed_ms",
        "cell_steps",
        "clock",
        "synchronized",
        "synchronization",
        "lifecycle_ms"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "checkpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time_seconds": {
                "type": "number"
              },
              "values": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "minProperties": 1,
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "time_seconds",
              "values"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "checkpoints"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "available"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "available": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "value"
              ],
              "not": {
                "required": [
                  "reason"
                ]
              }
            },
            "else": {
              "required": [
                "reason"
              ],
              "not": {
                "required": [
                  "value"
                ]
              }
            }
          }
        ]
      },
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "invalid",
        "ineligible"
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "campaign_id",
    "run_id",
    "block",
    "order_position",
    "solver",
    "manifest",
    "scenario",
    "configuration",
    "build",
    "resources",
    "timing",
    "state",
    "work",
    "status",
    "diagnostics"
  ],
  "additionalProperties": false
}
