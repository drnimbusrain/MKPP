{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MKPP manifest contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mechanism_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "canonical_source": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "revision",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "canonical_species": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "enum": [
              "active",
              "fixed",
              "diagnostic"
            ]
          },
          "phase": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "role",
          "phase",
          "unit",
          "scale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reactants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "species_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "coefficient": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "species_id",
                "coefficient"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "species_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "coefficient": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "species_id",
                "coefficient"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "rate_law_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rate_scale": {
            "type": "number",
            "minimum": 0
          },
          "rate_parameters": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean"
              ]
            },
            "minProperties": 0,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "reactants",
          "products",
          "rate_law_id",
          "rate_scale"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "chemistry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "photolysis_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "unit"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "required_solvers": {
      "type": "array",
      "items": {
        "enum": [
          "micm",
          "kpp",
          "mkpp"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assets": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "path",
                    "revision",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "minItems": 1
          },
          "species_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "photolysis_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minProperties": 0,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          }
        },
        "required": [
          "revision",
          "assets",
          "species_map",
          "photolysis_map"
        ],
        "additionalProperties": false
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "admission_status": {
      "enum": [
        "draft",
        "mapping_verified",
        "chemistry_verified",
        "trajectory_verified",
        "admitted",
        "ineligible"
      ]
    },
    "admission_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "mechanism_id",
    "version",
    "canonical_source",
    "canonical_species",
    "chemistry_sha256",
    "photolysis_inputs",
    "required_solvers",
    "bindings",
    "admission_status"
  ],
  "additionalProperties": false
}
