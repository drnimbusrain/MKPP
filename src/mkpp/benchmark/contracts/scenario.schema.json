{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MKPP scenario contract v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mechanism": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "role": {
      "enum": [
        "calibration",
        "measurement"
      ]
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "additionalProperties": false
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "additionalProperties": false
      },
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "forcing": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "constant": {
            "type": "number"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time_seconds": {
                  "type": "number"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "time_seconds",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "unit"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "constant"
            ],
            "not": {
              "required": [
                "points"
              ]
            }
          },
          {
            "required": [
              "points"
            ],
            "not": {
              "required": [
                "constant"
              ]
            }
          }
        ]
      },
      "minProperties": 0,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "start_seconds": {
          "type": "number"
        },
        "horizon_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "checkpoints_seconds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "forcing_boundaries_seconds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "start_seconds",
        "horizon_seconds",
        "checkpoints_seconds",
        "forcing_boundaries_seconds"
      ],
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "ensemble_seed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "cells",
        "ensemble_seed"
      ],
      "additionalProperties": false
    },
    "accuracy": {
      "type": "object",
      "properties": {
        "rtol": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "atol_by_species": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "positivity_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "conservation_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "rtol",
        "atol_by_species",
        "positivity_policy",
        "conservation_checks"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "max_refinements": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "implementation",
        "max_refinements"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "version",
    "mechanism",
    "role",
    "initial_state",
    "environment",
    "forcing",
    "integration",
    "workload",
    "accuracy",
    "reference"
  ],
  "additionalProperties": false
}
