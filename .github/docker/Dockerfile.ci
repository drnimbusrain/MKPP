FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
ENV KOKKOS_ROOT=/opt/kokkos
ENV PATH="/opt/kokkos/bin:${PATH}"

# Use the official Python 3.11 image to avoid installing Python from an
# external apt repository. The Deadsnakes PPA has intermittently returned
# HTTP 503s during CI image builds.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gfortran \
    cmake \
    ninja-build \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Keep pip build tooling current for PEP 660 editable installs.
RUN python -m pip install --no-cache-dir --root-user-action=ignore \
    --upgrade setuptools wheel

# Install Python packages required for MKPP build and testing
# NOTE: jsonschema must be pre-baked here: CTest targets that shell out to
# pytest (e.g. solver_benchmark_contract_admission_smoke) import
# mkpp.benchmark.schema, and the "pip install --no-build-isolation -e ." CI
# step may target a different interpreter than the configure-time Python3
# used by CTest.
RUN python -m pip install --no-cache-dir --root-user-action=ignore \
    cmake \
    ninja \
    pyyaml \
    sympy \
    jinja2 \
    networkx \
    matplotlib \
    pytest \
    pytest-xdist \
    jsonschema \
    hypothesis \
    numpy \
    scipy \
    pre-commit \
    ruff \
    mkdocs-material \
    mkdocstrings \
    mkdocstrings-python

# Build and install the minimum supported Kokkos 5.1.1 to /opt/kokkos
RUN git clone --depth 1 --branch 5.1.1 https://github.com/kokkos/kokkos.git /tmp/kokkos-src && \
    cmake -S /tmp/kokkos-src -B /tmp/kokkos-build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/opt/kokkos \
      -DKokkos_ENABLE_SERIAL=ON \
      -DKokkos_ENABLE_OPENMP=OFF \
      -DKokkos_ENABLE_CUDA=OFF && \
    cmake --build /tmp/kokkos-build -j $(nproc) && \
    cmake --install /tmp/kokkos-build && \
    rm -rf /tmp/kokkos-src /tmp/kokkos-build
