{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Release Build",
      "description": "Default build utilizing Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "dev-debug",
      "inherits": "default",
      "displayName": "Developer Debug Build",
      "description": "Build with debug symbols and extensive warnings enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-Wall -Wextra -pedantic",
        "CMAKE_Fortran_FLAGS": "-Wall -Wextra -pedantic"
      }
    },
    {
      "name": "device",
      "inherits": "default",
      "displayName": "Device Compile Gate Build",
      "description": "Release build with the device-callability gate enabled; the gate activates only when the linked Kokkos exposes a CUDA/HIP/SYCL backend, otherwise it reports device-unverified",
      "binaryDir": "${sourceDir}/build-device",
      "cacheVariables": {
        "MKPP_DEVICE_COMPILE_GATE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "device",
      "configurePreset": "device"
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "stopOnFailure": true}
    },
    {
      "name": "device",
      "configurePreset": "device",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error", "stopOnFailure": true}
    }
  ]
}
